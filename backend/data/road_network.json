      "low": 0,
      "medium": 5,
      "high": 12,
      "blocked": "not traversable"
    },
    "units": {
      "distance": "kilometres",
      "baseTravelTime": "minutes",
      "trafficDelay": "minutes"
    },
    "roadDirection": "bidirectional (each road is traversable in both directions at equal cost)"
  },

