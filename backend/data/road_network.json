  "metadata": {
    "name": "Smart Traffic Navigation System - Demonstration Road Network",
    "description": "A simulated road network used to demonstrate weighted-graph representation and Uniform Cost Search. Traffic levels are SIMULATED, not obtained from any real-time traffic service.",
    "costModel": "edgeCost = baseTravelTime + trafficDelay",
